# ---------------------------------------------------------------------------
# wunch environment variables. Copy to .env.local for local development.
# Never commit real values. On Vercel, set them under Project > Settings > Environment Variables.
# ---------------------------------------------------------------------------

# Public base URL of the site, used in emails and Stripe return URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL (local: http://127.0.0.1:54321, from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable key (sb_publishable_...), safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (sb_secret_...), server only: bypasses Row Level Security
SUPABASE_SECRET_KEY=

# Stripe secret key (sk_test_... for testing, sk_live_... in production), server only
STRIPE_SECRET_KEY=
# Stripe publishable key (pk_test_... / pk_live_...), used by the Payment Element
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint (whsec_...), from `stripe listen` locally or the Dashboard in production
STRIPE_WEBHOOK_SECRET=
# Local testing only: point the Stripe SDK at the bundled emulator (http://localhost:12111). Leave empty with real keys.
STRIPE_API_BASE_URL=

# Resend API key (re_...). If empty, emails go to MAILPIT_URL (local) or are only logged.
RESEND_API_KEY=
# Sender for all emails, must be on a domain verified in Resend
EMAIL_FROM="wunch <bestellung@wunch.ch>"
# Where customer replies go (optional)
EMAIL_REPLY_TO=
# Local testing only: Mailpit from the Supabase stack catches emails (http://127.0.0.1:54324)
MAILPIT_URL=

# Comma-separated emails that get the admin role (e.g. vince@wunch.ch)
ADMIN_EMAILS=

# Shared secret for the scheduled job (pg_cron calls /api/cron/tick with it). At least 16 random characters.
CRON_SECRET=
